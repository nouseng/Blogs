// Run from <Microduck repo>/build/<task>/ with: omc run.mos
loadModel(Modelica, {"4.1.0"});
loadFile("../../Duck/package.mo");
getErrorString();
loadFile("WalkNominal.mo");
simulate(WalkNominal, stopTime = 6, method = "rungekutta", numberOfIntervals = 6000, outputFormat = "csv",
  variableFilter = "^(time|robot[.](q|qRef)[[].*|servoTorque[[].*)$");
getErrorString();
loadFile("Stand200.mo");
simulate(Stand200, stopTime = 3, numberOfIntervals = 1500, outputFormat = "csv",
  variableFilter = "^(time|trunkHeight|trunkPitch)$");
getErrorString();
loadFile("Stand800.mo");
simulate(Stand800, stopTime = 3, numberOfIntervals = 1500, outputFormat = "csv",
  variableFilter = "^(time|trunkHeight|trunkPitch)$");
getErrorString();
